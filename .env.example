# Hack Club AI API key (https://ai.hackclub.com/dashboard)
# Optional now — only needed if you use Exa web search (SEARCH_PROVIDER=exa)
# or Hack Club for the LLM (LLM_PROVIDER=hackclub).
HACK_CLUB_AI_API_KEY=

# --- LLM provider: OpenRouter (recommended) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE=https://openrouter.ai/api/v1

# --- Discovery (web search) provider ---
# 'auto' (default): OpenRouter :online search if OPENROUTER_API_KEY is set, else Exa.
# 'openrouter': force OpenRouter web search.  'exa': force Hack Club Exa.
# SEARCH_PROVIDER=auto

# Optional overrides
# HC_AI_MODEL=qwen/qwen3-32b
# CONCURRENCY=3
# REQUEST_DELAY_MS=150
